{
  "name": "churchsheep",
  "version": "1.1.0",
  "private": true,
  "description": "教會 APP - 內容整合 + 個人化牧養工具 (Church App monorepo)",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/admin-web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:admin": "npm run dev --workspace apps/admin-web",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "public:api": "powershell -ExecutionPolicy Bypass -File scripts/start-public-api.ps1",
    "apk": "npm run apk --prefix apps/mobile",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace apps/api"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
