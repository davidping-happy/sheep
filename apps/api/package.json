{
  "name": "@churchsheep/api",
  "version": "1.1.0",
  "description": "教會 APP 後端 API — NestJS 核心服務層",
  "main": "dist/main.js",
  "scripts": {
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});try{fs.unlinkSync('tsconfig.tsbuildinfo')}catch{}\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:render": "prisma migrate deploy && node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "start:cloud-check": "node -e \"const u=process.env.DATABASE_URL||''; if(!u.startsWith('postgres')) {console.error('DATABASE_URL must be postgresql'); process.exit(1)} console.log('ok')\"",
    "seed": "ts-node prisma/seed.ts",
    "set-password": "ts-node scripts/set-password.ts",
    "demo": "node demo/demo.mjs",
    "demo:events": "node demo/demo-events.mjs",
    "demo:admin-prayer": "node demo/demo-admin-prayer.mjs",
    "demo:admin-events": "node demo/demo-admin-events.mjs",
    "demo:phase1": "node demo/demo-phase1.mjs",
    "demo:phase2": "node demo/demo-phase2.mjs",
    "demo:phase3": "node demo/demo-phase3.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.1.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2"
  }
}
