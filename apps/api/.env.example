# ── 資料庫 ──
# 本地 demo：SQLite（零外部依賴）
DATABASE_URL="file:./dev.db"
# 正式環境（設計文件要求 PostgreSQL）：改用下列並把 schema.prisma 的 provider 改成 "postgresql"
# DATABASE_URL="postgresql://churchsheep:CHANGE_ME@localhost:5432/churchsheep?schema=public"

# ── 伺服器 ──
PORT=3000
NODE_ENV=development
# 允許的前端來源 (CORS)，逗號分隔（後台 :3001、Expo 網頁 :8081）
CORS_ORIGINS="http://localhost:3001,http://localhost:8081,http://127.0.0.1:8081"

# ── 身份驗證 (§四.3) ──
# 短效期 access token
JWT_ACCESS_SECRET="CHANGE_ME_use_a_long_random_string"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_SECRET="CHANGE_ME_another_long_random_string"
JWT_REFRESH_TTL="30d"

# ── 欄位加密 (§四.1)：AES-256-GCM 32-byte key，hex 或 base64 ──
# 產生：openssl rand -hex 32
FIELD_ENCRYPTION_KEY="CHANGE_ME_64_hex_chars"

# ── YouTube Data API v3 (唯讀) ──
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# ── 推播 FCM ──
FCM_PROJECT_ID=""
# 建議用密鑰管理服務，不要硬寫 (§四.6)。此處為本地開發路徑範例。
FCM_SERVICE_ACCOUNT_PATH="./secrets/fcm-service-account.json"

# ── 選用：LINE Notify ──
LINE_NOTIFY_TOKEN=""

# ── 物件儲存 (S3 / GCS) ──
STORAGE_BUCKET=""
STORAGE_REGION=""

# ── 速率限制 (§四.4) ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
