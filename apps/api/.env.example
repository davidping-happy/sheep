# ── 資料庫（PostgreSQL）──
# 本機：先在 repo 根目錄執行 docker compose up -d，再用下面這行
DATABASE_URL="postgresql://churchsheep:churchsheep@localhost:5432/churchsheep?schema=public"
# 雲端：填 Render / Neon 提供的 connection string（勿提交真實密碼）

# ── 伺服器 ──
PORT=3000
NODE_ENV=development
# 允許的前端來源 (CORS)，逗號分隔
# 本機：後台 :3001、Expo :8081
# 雲端：再加上 Render 靜態站／Expo 網頁網址；App（APK）不走瀏覽器 CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:8081,http://127.0.0.1:8081"

# ── 初始管理員 ──
# 種子建立 admin@church.local 時使用的密碼；未設定會用開發預設值並印出警告。
# 已建立後要改密碼請執行：npm run set-password
SEED_ADMIN_PASSWORD=""

# ── 身份驗證 (§四.3) ──
JWT_ACCESS_SECRET="CHANGE_ME_use_a_long_random_string"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_SECRET="CHANGE_ME_another_long_random_string"
JWT_REFRESH_TTL="30d"

# ── 欄位加密 (§四.1)：AES-256-GCM 32-byte key，hex ──
# 產生：openssl rand -hex 32
FIELD_ENCRYPTION_KEY="CHANGE_ME_64_hex_chars"

# ── YouTube Data API v3（唯讀）──
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCdcDDnZj76AwNqj18jtTAgw"
YOUTUBE_CHANNEL_URL="https://www.youtube.com/@breadoflifechristianchurch9830"

# ── 推播 FCM ──
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_PATH="./secrets/fcm-service-account.json"

# ── 選用：LINE Notify ──
LINE_NOTIFY_TOKEN=""

# ── 物件儲存 (S3 / GCS) ──
STORAGE_BUCKET=""
STORAGE_REGION=""

# ── 速率限制 (§四.4) ──
THROTTLE_TTL=60
THROTTLE_LIMIT=100
